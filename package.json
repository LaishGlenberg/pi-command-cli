{
  "name": "@lglen/pi-command-cli",
  "version": "1.1.3",
  "description": "QoL node cli for spawning pi sessions in the tui",
  "license": "MIT",
  "author": "lglen",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "pi-cli": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LaishGlenberg/pi-command-cli.git"
  },
  "homepage": "https://github.com/LaishGlenberg/pi-command-cli#readme",
  "bugs": "https://github.com/LaishGlenberg/pi-command-cli/issues",
  "keywords": [
    "pi",
    "pi-coding-agent",
    "cli",
    "agents",
    "extensions",
    "skills"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "test": "node --test",
    "lint": "oxlint --deny-warnings index.ts src test"
  },
  "devDependencies": {
    "@types/node": "^24.13.6",
    "oxlint": "^1.85.0",
    "typescript": "7.0.2"
  }
}
